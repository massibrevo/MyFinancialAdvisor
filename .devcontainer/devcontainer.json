{
  "name": "MyFinancialAdvisor 2.0",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "main.py"] },
    "vscode": { "extensions": ["ms-python.python", "ms-python.vscode-pylance"] }
  },
  "forwardPorts": [8501],
  "portsAttributes": { "8501": { "label": "MyFinancialAdvisor", "onAutoForward": "openPreview" } }
}
